  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "electron": "45.2.3",
    "typescript": "^6.0.0"
  }
}
